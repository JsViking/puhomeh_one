rules_version = '2';

// Правила Cloud Firestore для таблицы рекордов.
// Любой может читать топ и добавить СВОЙ результат; менять и удалять чужие — нельзя.
service cloud.firestore {
  match /databases/{database}/documents {

    match /scores/{scoreId} {
      allow get: if true;
      // Читать можно только ограниченными порциями — защита от выкачивания всей коллекции
      allow list: if request.query.limit <= 50;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'time', 'createdAt']) &&
        request.resource.data.keys().hasAll(['name', 'time', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 12 &&
        request.resource.data.time is number &&
        request.resource.data.time >= 10 &&      // быстрее 10 секунд собрать 12 штук еды невозможно
        request.resource.data.time <= 3600 &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Отзывы: игроки могут только отправлять. Читать — только владелец проекта в консоли Firebase.
    match /feedback/{feedbackId} {
      allow create: if
        request.resource.data.keys().hasOnly(['text', 'contact', 'ua', 'createdAt']) &&
        request.resource.data.keys().hasAll(['text', 'ua', 'createdAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 3 &&
        request.resource.data.text.size() <= 1000 &&
        (!('contact' in request.resource.data) ||
          (request.resource.data.contact is string && request.resource.data.contact.size() <= 100)) &&
        request.resource.data.ua is string &&
        request.resource.data.ua.size() <= 300 &&
        request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    // Всё остальное в базе закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
